# Nothing here is required. With no variables set, the app runs in FREE assisted mode:
# users open pump.fun/profile/NAME and mark what they see. No requests go to Pump.fun.

# OPTIONAL: Pump.fun official Developer API key (pf_live_...), free for approved
# developers. Enables automatic checks. SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_.
# Apply at https://developers.pump.fun
PUMP_API_KEY=

# OPTIONAL experiment (off): automatic check from the user's browser. Set ONLY after proving
# an endpoint is public, unauthenticated, not bot-challenged for browsers, allows
# cross-origin reads, and returns {"exists_flag": boolean}. Template must contain {username}.
# NEXT_PUBLIC_BROWSER_CHECK_URL=https://example/{username}

# Official API base (production). Devnet: https://api-devnet.pump.fun/v1
PUMP_OFFICIAL_API_BASE=https://api.pump.fun/v1

# Opt-in (not recommended): set to 1 to also try Pump.fun's unofficial,
# Cloudflare-protected sources when the official API is missing or inconclusive.
PUMP_UNOFFICIAL_FALLBACK=0

# Minimum milliseconds between outbound requests to Pump.fun (per server instance).
PUMP_MIN_REQUEST_INTERVAL_MS=400

# Per-request timeout in milliseconds.
PUMP_REQUEST_TIMEOUT_MS=10000

# Override the Pump.fun API base (if Pump.fun moves its frontend API).
PUMP_API_BASE=https://frontend-api-v3.pump.fun

# Override the public profile base used for profile URLs and page corroboration.
PUMP_PROFILE_BASE=https://pump.fun/profile

# Optional server-side check history (SQLite via node:sqlite). Leave unset to disable.
# On Vercel the filesystem is ephemeral; use /tmp/history.db or leave disabled.
# HISTORY_DB_PATH=./data/history.db

# Max checks per client IP per minute against /api/check.
CHECK_RATE_LIMIT_PER_MINUTE=120

# Set to 1 to skip the public profile page corroboration request.
PUMP_DISABLE_PAGE_CHECK=0
